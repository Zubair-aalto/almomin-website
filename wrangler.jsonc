// Cloudflare Workers settings for almomin.eu.
// Build (Cloudflare dashboard): build command `python3 tools/build-all.py`, deploy command `npx wrangler deploy`.
// Secrets (Settings → Variables and Secrets): STRIPE_SECRET_KEY, ADMIN_PASSWORD, GITHUB_TOKEN, STRIPE_WEBHOOK_SECRET.
{
  "name": "almomin",
  "main": "server/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true },
  // Secrets set in the dashboard are kept when deploying
  "keep_vars": true
}
